# Mật khẩu cho container postgres và redis. Copy thành `.env.production.db`
# TRÊN VPS, đặt mật khẩu mạnh, và KHÔNG commit.
#
# Redis bật `requirepass` kể cả khi nó không lộ ra Internet — phòng tuyến thứ
# hai cho trường hợp một service khác trong stack bị chiếm.

POSTGRES_DB=hanora
POSTGRES_USER=hanora
POSTGRES_PASSWORD=

REDIS_PASSWORD=
