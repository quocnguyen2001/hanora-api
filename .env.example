APP_NAME=hanora
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Ranh giới ngày (streak, lịch ôn) tính theo múi giờ này, không phải UTC.
APP_TIMEZONE=Asia/Ho_Chi_Minh

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=hanora
DB_USERNAME=hanora
DB_PASSWORD=secret


SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# Origin của frontend khi nó chạy TÁCH KHỎI API (chỉ xảy ra ở dev, cổng 5173).
# Dùng cho hai việc: allowed_origins của CORS, và link đặt lại mật khẩu.
#
# PHẢI để trống ở production. FE cùng origin với API (D12) nên:
#   - không có request cross-origin -> allowed_origins rỗng là đúng
#   - link đặt lại mật khẩu rơi về APP_URL, cũng là đúng
# Còn giá trị ở đây trên production tức là ship một CORS grant không ai cần.
# Env production do P20 dựng riêng, không copy từ file này.
FRONTEND_URL=http://localhost:5173

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@hanora.app"
MAIL_FROM_NAME="${APP_NAME}"
