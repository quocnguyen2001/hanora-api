# Template env PRODUCTION. Copy thành `.env.production` TRÊN VPS.
#
# KHÔNG commit `.env.production`. `.gitignore` đã chặn `.env*`, nhưng đừng dựa
# vào đó một mình — kiểm `git status` trước mỗi lần commit đầu tiên trên máy mới.

APP_NAME=hanora
APP_ENV=production
# Sinh trên VPS: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://hanora.example.com

APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en

# ĐỂ TRỐNG. FE cùng origin với API (D12): không CORS, và link đặt lại mật khẩu
# rơi về APP_URL — cả hai đều đúng.
FRONTEND_URL=

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=hanora
DB_USERNAME=hanora
DB_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# CIDR mạng Docker nội bộ mà nginx nằm trong đó.
# TUYỆT ĐỐI KHÔNG đặt `*`: kẻ tấn công đổi X-Forwarded-For mỗi request là rate
# limit theo IP của P9 biến mất hoàn toàn.
TRUSTED_PROXIES=172.16.0.0/12

# Mail cho luồng đặt lại mật khẩu (P9). Không cấu hình thì quên mật khẩu =
# mất tài khoản vĩnh viễn.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=no-reply@hanora.example.com
MAIL_FROM_NAME=hanora
