<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_TIMEZONE" value="Asia/Ho_Chi_Minh"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
          Test chạy trên PostgreSQL thật, KHÔNG SQLite. P6 có generated column
          dùng extension unaccent; trên SQLite lỗi đó chỉ lộ ra lúc deploy.
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="hanora_test"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>

        <!--
            Lớp AI TẮT mặc định trong test.

            Không có dòng này, `config('services.gemini.key')` rơi về `.env` của
            máy đang chạy và một test tìm kiếm bình thường sẽ gọi API thật: chậm
            (đo được 3,55s cho một test vốn 40ms), tốn tiền, phụ thuộc mạng, và
            cho kết quả khác nhau giữa hai lần chạy.

            Test nào cần lớp AI thì tự bật bằng
            `config(['services.gemini.key' => 'test-key'])` kèm `Http::fake()`.
            Bật có chủ đích, không bật do quên.
        -->
        <env name="GEMINI_API_KEY" value=""/>

        <!--
            Van giảm áp RPM tắt trong test.

            `Redis::throttle` giữ trạng thái TRONG REDIS, và Redis không bị dọn
            giữa các test như `CACHE_STORE=array`. Với trần 10/phút mặc định,
            test thứ mười một trong cùng một phút bị chặn 5 giây rồi `release()`
            — nó hỏng vì test TRƯỚC nó, ở file khác, và triệu chứng trông không
            liên quan gì tới nguyên nhân.

            Test không bao giờ gọi mạng thật (`Http::fake`), nên giữ nhịp cho
            chúng là thuần lãng phí cộng một nguồn phụ thuộc giữa các test.
        -->
        <env name="GEMINI_RPM" value="100000"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
